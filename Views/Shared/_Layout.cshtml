<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] - AI Travel Planner</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
  <style>
    body { background: #f4f7fb; }
    .hero { background: linear-gradient(135deg,#0d6efd,#6610f2); color:#fff; padding:3rem 0 4.5rem; }
    .planner-card { margin-top:-3rem; border:0; box-shadow:0 .75rem 2rem rgba(0,0,0,.12); }
    .plan-output h1,.plan-output h2{ font-size:1.35rem; margin-top:1.5rem; border-bottom:1px solid #e5e5e5; padding-bottom:.3rem;}
    .plan-output h3{ font-size:1.1rem; margin-top:1.2rem; }
    .plan-output table{ width:100%; margin:1rem 0; }
    .plan-output th,.plan-output td{ border:1px solid #dee2e6; padding:.4rem .6rem; }
    .plan-output th{ background:#f1f3f5; }
    .badge-weather{background:#0dcaf0;color:#000}.badge-hotel{background:#198754}.badge-flight{background:#fd7e14}
    pre.trace{ background:#212529; color:#9ef; padding:.6rem; border-radius:.4rem; font-size:.8rem; white-space:pre-wrap; }
  </style>
</head>
<body>
  @RenderBody()
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
